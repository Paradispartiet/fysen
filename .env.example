# PostgreSQL / Supabase direct or pooled connection URL.
DATABASE_URL=postgresql://fysen:fysen@localhost:5432/fysen

# Set to 1 only when the database endpoint requires TLS.
DATABASE_SSL=0

# Menu watcher runtime defaults. Scheduled production crawling must set an
# identifiable contact-bearing user agent before it is enabled.
FYSEN_MENU_BOT_USER_AGENT=FysenMenuBot/0.1
FYSEN_HTTP_TIMEOUT_MS=12000
FYSEN_MAX_RESPONSE_BYTES=2097152
FYSEN_MIN_HOST_DELAY_MS=1000
