{
  "name": "@fysen/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/migration.test.ts src/client.test.ts src/due-sources.test.ts",
    "migrate": "node dist/migrate.js",
    "verify:production": "node dist/verify-production.js",
    "test:integration": "vitest run src/integration.test.ts && vitest run src/search.integration.test.ts && vitest run src/funnel.integration.test.ts && vitest run src/restaurant-actions.integration.test.ts && vitest run src/restaurant-hours.integration.test.ts"
  },
  "dependencies": {
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "5.9.2",
    "vitest": "4.1.0"
  }
}
