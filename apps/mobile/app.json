{
  "expo": {
    "name": "Fysen",
    "slug": "fysen",
    "scheme": "fysen",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090b09",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.fysen.app"
    },
    "android": {
      "package": "no.fysen.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#070807"
      }
    },
    "extra": {
      "apiBaseUrl": "https://fysen-api.vercel.app"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090b09"
    }
  }
}
