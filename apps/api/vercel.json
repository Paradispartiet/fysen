{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack pnpm --version && corepack pnpm install --no-frozen-lockfile",
  "ignoreCommand": "bash ../../scripts/vercel-ignore.sh api",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "preview-*": true,
      "*": false
    }
  },
  "github": {
    "autoJobCancelation": true
  }
}
